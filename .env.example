# Supabase is optional for local-only development.
# If one Supabase variable is set, both must be set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only Gemini key for weekly cloud analysis.
# Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional Android APK target used by Capacitor.
# Use a deployed HTTPS URL for real builds, or a LAN URL for local phone testing.
CAPACITOR_SERVER_URL=
